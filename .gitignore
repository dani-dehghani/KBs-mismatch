.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/
build/
dist/
htmlcov/
.coverage
tmp/

# Reproducible local-only artifacts
checkpoints/
*.pt
*.pth
*.ckpt

# Keep source documents tracked.
!*.pdf

# Keep the recorded research artifacts tracked (large binaries use Git LFS).
!outputs/
!outputs/**
!outputs/**/*.pt

# Never publish macOS Finder metadata, including inside re-included directories.
**/.DS_Store
